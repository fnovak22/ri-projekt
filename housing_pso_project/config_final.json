{
  "data_path": "data/data_housing_cleaned_transformed.csv",
  "target_column": "price",
  "test_size": 0.15,
  "validation_size": 0.15,
  "random_state": 42,
  "remove_zero_prices": true,
  "remove_price_outliers": true,
  "price_outlier_quantile": 0.99,
  "hidden_neurons": 8,
  "comparison_training_sample_size": 2500,
  "backprop": {
    "max_iter": 1200,
    "learning_rate_init": 0.001,
    "early_stopping": true,
    "n_iter_no_change": 60
  },
  "pso": {
    "particles": 50,
    "iterations": 300,
    "inertia_start": 0.9,
    "inertia_end": 0.4,
    "cognitive_coefficient": 1.49445,
    "social_coefficient": 1.49445,
    "position_min": -2.0,
    "position_max": 2.0,
    "velocity_min": -0.3,
    "velocity_max": 0.3
  }
}
